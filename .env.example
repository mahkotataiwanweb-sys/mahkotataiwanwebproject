NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_PASSWORD=your_supabase_db_password
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin login — bcrypt hash of the password (cost 10).
# Generate locally with:  node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# If unset, the API falls back to a built-in hash for 'mahkota168'.
ADMIN_PASSWORD_HASH=$2b$10$replace_this_with_your_own_hash

# Anthropic Claude API key — used for CMS auto-translate (model: claude-sonnet-4-20250514)
# If unset, the /api/translate endpoint silently falls back to Google Translate.
ANTHROPIC_API_KEY=your_anthropic_api_key
